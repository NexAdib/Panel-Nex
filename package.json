{
  "name": "nexadib",
  "version": "1.0.0",
  "private": true,
  "description": "NexAdib — personal Cloudflare Workers proxy panel (VLESS/Trojan over WebSocket) with subscriptions, fixed-IP exits, WARP and multi-account management.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:assets": "node scripts/embed-assets.mjs",
    "gen:stub": "node scripts/embed-assets.mjs --stub-if-missing",
    "build:ui": "vite build && node scripts/embed-assets.mjs",
    "build": "node scripts/build.mjs",
    "dev": "npm run gen:stub && wrangler dev",
    "deploy": "npm run build && wrangler deploy dist/worker.js --no-bundle",
    "typecheck": "npm run gen:stub && tsc -p tsconfig.json --noEmit && tsc -p src/ui/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run gen:stub && vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "lucide-preact": "^1.48.0",
    "playwright": "^1.63.0",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
